"""
exo12-Réalisez un algorithme utilisant le convertisseur de
secondes, il reçoit deux durées (jours, heures, minutes et
secondes) et calcule la différence entre ces dernières.

"""

variable nb_jour : entier = écrire "Entrez un nombre de jours : "
variable nb_heure : entier = écrire "Entrez un nombre d'heure : "
variable nb_minute : entier = écrire "Entrez un nombre de minutes : "
variable nb_seconde : entier = écrire "Entrez un nombre seconds : "

variable nb_jour2 : entier = écrire "Entrez un second nombre de jours : "
variable nb_heure2 : entier = écrire "Entrez un second nombre d'heure : "
variable nb_minute2 : entier = écrire "Entrez un second nombre de minutes : "
variable nb_seconde2 : entier = écrire "Entrez un second nombre seconds : "

DEBUT
    nombre1 egale nb_jour FOIS 86400 PLUS nb_heure * 3600 PLUS nb_minute FOIS 60 PLUS nb_seconde
    nombre2 egale nb_jour FOIS 86400 PLUS nb_heure * 3600 PLUS nb_minute FOIS 60 PLUS nb_seconde

    si nombre1 est superieur à nombre2 alors
        resultat égale nombre1 MOINS nombre2
    sinon
        resultat égale nombre2 MOINS nombre1
	finsi
FIN